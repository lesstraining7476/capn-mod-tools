{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "capn-mod-tools",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "triggers": {
    "onPostReport": "/internal/triggers/on-post-report"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "capn_mod_tools_dev"
  },
  "settings": {
    "global": {
      "webhookDevelopment": {
        "type": "string",
        "label": "Discord Webhook URL (Development)",
        "isSecret": true
      },
      "webhookProduction": {
        "type": "string",
        "label": "Discord Webhook URL (Production)",
        "isSecret": true
      }
    },
    "subreddit": {
      "filterSpamReports": {
        "type": "select",
        "label": "Filter Spam Reports",
        "options": [
          {
            "label": "On",
            "value": "on"
          },
          {
            "label": "Off",
            "value": "off"
          }
        ],
        "defaultValue": "on"
      },
      "environment": {
        "type": "select",
        "label": "Application Environment",
        "options": [
          {
            "label": "Production",
            "value": "Production"
          },
          {
            "label": "Development",
            "value": "Development"
          }
        ],
        "defaultValue": "Development"
      }
    }
  }
}
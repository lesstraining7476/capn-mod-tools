{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "capn-mod-tools",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "triggers": {
    "onPostReport": "/internal/triggers/on-post-report",
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "handleModQueue": {
        "endpoint": "/internal/scheduler/handle-mod-queue",
        "cron": "*/1 * * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "capn_mod_tools_dev"
  },
  "settings": {
    "global": {
      "webhookDevelopment": {
        "type": "string",
        "label": "Discord Webhook URL (Development)",
        "isSecret": true
      },
      "webhookProduction": {
        "type": "string",
        "label": "Discord Webhook URL (Production)",
        "isSecret": true
      },
      "botApplicationId": {
        "type": "string",
        "label": "Discord Bot Application Id",
        "isSecret": true
      },
      "botPublicKey": {
        "type": "string",
        "label": "Discord Bot Application Id",
        "isSecret": true
      },
      "botToken": {
        "type": "string",
        "label": "Discord Bot Token",
        "isSecret": true
      },
      "subredditsDevelopment": {
        "type": "string",
        "label": "List of subreddits being managed (Development)",
        "isSecret": true
      },
      "subredditsProduction": {
        "type": "string",
        "label": "List of subreddits being managed (Production)",
        "isSecret": true
      },
      "discordModQueueChannelDevelopment": {
        "type": "string",
        "label": "Discord Mod Queue Channel (Development)",
        "isSecret": true
      },
      "discordModQueueChannelProduction": {
        "type": "string",
        "label": "Discord Mod Queue Channel (Production)",
        "isSecret": true
      }
    },
    "subreddit": {
      "filterSpamReports": {
        "type": "boolean",
        "label": "Filter Spam Reports"
      },
      "environment": {
        "type": "select",
        "label": "Application Environment",
        "options": [
          {
            "label": "Production",
            "value": "Production"
          },
          {
            "label": "Development",
            "value": "Development"
          }
        ],
        "defaultValue": "Development"
      }
    }
  }
}
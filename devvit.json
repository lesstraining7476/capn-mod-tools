{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "capn-mod-tools",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "triggers": {
    "onPostReport": "/internal/triggers/on-post-report"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "capn_mod_tools_dev"
  },
  "settings": {
    "environment": {
      "type": "select",
      "label": "Environment",
      "options": [
        {
          "label": "Production",
          "value": "production"
        },
        {
          "label": "Development",
          "value": "dev"
        }
      ],
      "defaultValue": "dev"
    },
    "filterSpamReports": {
      "type": "select",
      "label": "Filter Spam Reports",
      "options": [
        {
          "label": "On",
          "value": true
        },
        {
          "label": "Off",
          "value": false
        }
      ],
      "defaultValue": true
    }
  }
}